<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Barra de cima -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/sub"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Player -->
    <FrameLayout
        android:id="@+id/playerBox"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shutter_background_color="#000000"
            app:use_controller="false" />

        <TextView
            android:id="@+id/tvOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:paddingHorizontal="8dp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Conteúdo das abas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ABA CORTAR -->
        <ScrollView
            android:id="@+id/panelCut"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomOut"
                        style="@style/Btn"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:text="−"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvZoom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/sub"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomFit"
                        style="@style/Btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:text="Tudo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomFine"
                        style="@style/Btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:text="Preciso" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnZoomIn"
                        style="@style/Btn"
                        android:layout_width="44dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textSize="18sp" />
                </LinearLayout>

                <com.leve.editor.TimelineView
                    android:id="@+id/timeline"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvSel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBack1"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="−1s" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackF"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="−0,1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlay"
                        style="@style/BtnMain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1.3"
                        android:text="▶" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFwdF"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="+0,1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFwd1"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+1s" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIn"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="[  Início" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOut"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:text="Fim  ]" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/Btn"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:text="Limpar" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/BtnMain"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="4dp"
                    android:text="✂  Salvar cena" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEdit"
                    style="@style/Btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="Cancelar ajuste"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Barra fina no topo = filme inteiro (toque para pular). Arraste a linha do tempo • pinça ou − / + para zoom • Preciso = quadro a quadro • arraste as bordas brancas para ajustar o corte. Depois de salvar, o próximo Início já fica no Fim da cena anterior."
                    android:textColor="@color/sub"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ABA CENAS -->
        <LinearLayout
            android:id="@+id/panelScenes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/tvScenesInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAll"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas → Montagem" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvScenes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/tvScenesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Nenhuma cena ainda.\nVá na aba Cortar, marque Início e Fim e salve."
                    android:textColor="@color/sub" />
            </FrameLayout>
        </LinearLayout>

        <!-- ABA MONTAGEM -->
        <LinearLayout
            android:id="@+id/panelSeq"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/tvSeqInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoText"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T  Títulos" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSeq"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvSeqEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="A montagem está vazia.\nNa aba Cenas, toque no + para colocar a cena aqui.\nSegure e arraste (≡) para mudar a ordem. Toque na cena para pôr texto."
                    android:textColor="@color/sub" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreviewSeq"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="▶  Pré-visualizar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExport"
                    style="@style/BtnMain"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="⬆  Exportar vídeo" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/nav" />
</LinearLayout>
